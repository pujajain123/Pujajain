{
  "name": "umami-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Umami Studios — order, production, job sheet & inventory operations platform",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:codex": "node scripts/package-codex.mjs",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/package-demo.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts --reset",
    "import": "tsx server/import/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec server/tests/*.test.ts",
    "ops": "tsx ops-server/index.ts",
    "ops:dev": "tsx watch ops-server/index.ts",
    "ops:start": "NODE_ENV=production tsx ops-server/index.ts",
    "ops:user": "tsx ops-server/cli.ts",
    "ops:backup": "tsx ops-server/cli.ts backup",
    "ops:test": "NODE_ENV=test node --import tsx --test --test-reporter=spec ops-server/tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sql.js": "^1.10.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
